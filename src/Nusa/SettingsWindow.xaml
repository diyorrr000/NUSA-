<Window x:Class="Nusa.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nusa — Sozlamalar"
        Width="560" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#141416" Foreground="White"
        Icon="Assets/nusa.ico"
        UseLayoutRounding="True">
    <Grid>
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="28,22,28,28"/>
        </ScrollViewer>
    </Grid>
</Window>
