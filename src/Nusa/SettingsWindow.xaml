<Window x:Class="Nusa.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nusa — Sozlamalar"
        Width="820" Height="760" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#141416" Foreground="White"
        Icon="Assets/nusa.ico"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Chap menyu: logo va bo'limlar -->
        <Border x:Name="NavBg" Background="#0D0D0F">
            <DockPanel Margin="14,20,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,20">
                    <Image Source="Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Nusa" FontSize="19" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource SubText}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="Nav"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="30,22,30,30" MaxWidth="640" HorizontalAlignment="Stretch"/>
        </ScrollViewer>
    </Grid>
</Window>
