<Window x:Class="Nusa.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Nusa.Controls"
        Title="Nusa"
        Width="760" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <StackPanel x:Name="NotchRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- Chap "quloq": ekran chetiga silliq ulanish -->
            <Path x:Name="LeftEar" Fill="Black" Width="12" Height="12" VerticalAlignment="Top"
                  Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z"/>

            <Border x:Name="Island" Background="Black" CornerRadius="0,0,16,16"
                    Width="150" Height="32" ClipToBounds="True" AllowDrop="True"
                    MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                    MouseLeftButtonUp="Island_Click"
                    DragEnter="Island_DragEnter" DragLeave="Island_DragLeave" Drop="Island_Drop"
                    PreviewMouseLeftButtonDown="Island_PreviewDown" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="IslandScale"/>
                </Border.RenderTransform>
                <Grid>
                    <!-- ===== LIQUID GLASS: orqa qatlamlar (Glass/GlassConfig.cs dagi qiymatlar bilan) ===== -->
                    <Grid x:Name="GlassLayers" IsHitTestVisible="False" Visibility="Collapsed">
                        <!-- 4-bosqich: sindirilgan fon tasviri -->
                        <Image x:Name="RefractionImage" Stretch="Fill" Visibility="Collapsed">
                            <Image.Effect>
                                <BlurEffect x:Name="RefractionBlurFx" Radius="2"/>
                            </Image.Effect>
                        </Image>
                        <!-- Tepadagi xira oq nur dog'i -->
                        <Border x:Name="TopSpot" VerticalAlignment="Top"/>
                        <!-- Qirradan ichkariga so'nadigan yumshoq nur -->
                        <Border x:Name="InnerGlow" BorderThickness="6,0,6,6" Margin="0,-10,0,0">
                            <Border.Effect>
                                <BlurEffect x:Name="InnerGlowBlur" Radius="18"/>
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <!-- ===== YIG'ILGAN HOLAT ===== -->
                    <Grid x:Name="CollapsedView" Height="32" VerticalAlignment="Top">
                        <!-- Kompakt holat: robotcha · soat · qo'ng'iroqcha -->
                        <Grid x:Name="IdleView" Margin="9,0,11,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <c:Robot x:Name="RobotView" Width="30" Height="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MiniClock" Grid.Column="1" Text="18:55" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Zaryadlanayotganda: ⚡ 82% -->
                            <TextBlock x:Name="ChargeText" Grid.Column="2" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Green}" Visibility="Collapsed"/>
                            <Grid x:Name="BellView" Grid.Column="2" Width="18" Height="18" VerticalAlignment="Center">
                                <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="14"/>
                                <Ellipse x:Name="BellDot" Width="6" Height="6" Fill="{StaticResource Accent}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>

                        <!-- Musiqa -->
                        <Grid x:Name="MiniMusic" Visibility="Collapsed" Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource Card}" VerticalAlignment="Center">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,20,20" RadiusX="5" RadiusY="5"/>
                                </Border.Clip>
                                <Image x:Name="MiniArt" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="MiniLyric" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                            <!-- Ovoz to'lqini (ko'kdan binafshaga) -->
                            <StackPanel x:Name="Bars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="18"/>
                        </Grid>

                        <!-- Pomodoro -->
                        <Grid x:Name="MiniTimer" Visibility="Collapsed" Margin="12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Grid Width="18" Height="18">
                                    <Ellipse Stroke="#33FFFFFF" StrokeThickness="2.5"/>
                                    <Path x:Name="MiniRing" Stroke="{StaticResource Orange}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                                <TextBlock x:Name="MiniPhase" Text="Diqqat" Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource Orange}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MiniRemaining" Text="25:00" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Orange}"/>
                        </Grid>


                        <!-- Yuklanayotgan fayl -->
                        <Grid x:Name="MiniDownload" Visibility="Collapsed" Margin="10,0,14,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="11"/>
                                </Border>
                                <TextBlock x:Name="MiniDownloadName" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" MaxWidth="150" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MiniDownloadInfo" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource Teal}" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>

                    <!-- ===== OGOHLANTIRISH ===== -->
                    <Grid x:Name="AlertView" Visibility="Collapsed" Margin="12,0" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AlertIconBg" Width="30" Height="30" CornerRadius="15" Background="#2230D158" VerticalAlignment="Center">
                            <TextBlock x:Name="AlertIcon" Style="{StaticResource Icon}" FontSize="14"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                            <TextBlock x:Name="AlertTitle" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AlertSub" Style="{StaticResource SubText}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Grid x:Name="AlertProgress" Grid.Column="2" Width="80" Height="5" VerticalAlignment="Center">
                            <Border Background="#33FFFFFF" CornerRadius="2.5"/>
                            <Border x:Name="AlertProgressFill" HorizontalAlignment="Left" Width="40" CornerRadius="2.5" Background="White"/>
                        </Grid>

                        <!-- Batareya rasmi + foiz (zaryadlovchi ulanganda/uzilganda) -->
                        <StackPanel x:Name="AlertBattery" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="AlertBatteryPct" Text="82%" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Grid VerticalAlignment="Center">
                                <Border Width="38" Height="19" CornerRadius="5" BorderThickness="1.6" BorderBrush="#77FFFFFF" Padding="2">
                                    <Grid>
                                        <Border x:Name="AlertBatteryFill" HorizontalAlignment="Left" Width="20" CornerRadius="2.5" Background="{StaticResource Green}"/>
                                        <TextBlock x:Name="AlertBatteryBolt" Text="&#xE945;" Style="{StaticResource Icon}" FontSize="10" Foreground="White"/>
                                    </Grid>
                                </Border>
                                <Border Width="3" Height="7" CornerRadius="0,1.5,1.5,0" Background="#77FFFFFF"
                                        HorizontalAlignment="Right" Margin="0,0,-3.5,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ===== OCHILGAN HOLAT ===== -->
                    <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0" Width="660" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,8,12,0">
                            <StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="BigDate" Style="{StaticResource SubText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="BigClock" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="13" Content="&#xE713;"
                                        ToolTip="Sozlamalar" Click="Settings_Click"/>
                            </StackPanel>
                        </Grid>
                        <ContentControl x:Name="PageHost" Grid.Row="1" Margin="16,4,16,14" Focusable="False"/>
                    </Grid>

                    <!-- ===== LIQUID GLASS: yuqori qatlamlar ===== -->
                    <!-- Qirradagi yaltiroq chiziq (yorug'lik yo'nalishi sichqoncha bilan o'zgaradi) -->
                    <Border x:Name="Rim" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <!-- Bosilganda tarqaladigan yorug'lik -->
                    <Canvas x:Name="RippleLayer" IsHitTestVisible="False" ClipToBounds="True"/>
                </Grid>
            </Border>

            <!-- O'ng "quloq" -->
            <Path x:Name="RightEar" Fill="Black" Width="12" Height="12" VerticalAlignment="Top"
                  Data="M0,0 L12,0 A12,12 0 0 0 0,12 Z"/>
        </StackPanel>
    </Grid>
</Window>
