<Window x:Class="Nusa.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nusa"
        Width="760" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <StackPanel x:Name="NotchRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- Chap "quloq": ekran chetiga silliq ulanish -->
            <Path x:Name="LeftEar" Fill="Black" Width="12" Height="12" VerticalAlignment="Top"
                  Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z"/>

            <Border x:Name="Island" Background="Black" CornerRadius="0,0,16,16"
                    Width="150" Height="32" ClipToBounds="True" AllowDrop="True"
                    MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                    MouseLeftButtonUp="Island_Click"
                    DragEnter="Island_DragEnter" DragLeave="Island_DragLeave" Drop="Island_Drop">
                <Grid>
                    <!-- ===== YIG'ILGAN HOLAT ===== -->
                    <Grid x:Name="CollapsedView" Height="32" VerticalAlignment="Top">
                        <!-- Soat -->
                        <TextBlock x:Name="MiniClock" Text="18:55" FontSize="13.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Musiqa -->
                        <Grid x:Name="MiniMusic" Visibility="Collapsed" Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource Card}" VerticalAlignment="Center">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,20,20" RadiusX="5" RadiusY="5"/>
                                </Border.Clip>
                                <Image x:Name="MiniArt" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="MiniLyric" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel x:Name="Bars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16">
                                <Rectangle x:Name="Bar1" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="White"/>
                                <Rectangle x:Name="Bar2" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="White"/>
                                <Rectangle x:Name="Bar3" Width="3" Height="8" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="White"/>
                                <Rectangle x:Name="Bar4" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="White"/>
                            </StackPanel>
                        </Grid>

                        <!-- Pomodoro -->
                        <Grid x:Name="MiniTimer" Visibility="Collapsed" Margin="12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Grid Width="18" Height="18">
                                    <Ellipse Stroke="#33FFFFFF" StrokeThickness="2.5"/>
                                    <Path x:Name="MiniRing" Stroke="{StaticResource Orange}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                                <TextBlock x:Name="MiniPhase" Text="Diqqat" Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource Orange}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MiniRemaining" Text="25:00" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Orange}"/>
                        </Grid>

                        <!-- Maskot: ko'zchalar -->
                        <Grid x:Name="MascotView" Visibility="Collapsed">
                            <StackPanel x:Name="Eyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="EyeL" Width="9" Height="15" CornerRadius="4.5" Background="White" Margin="5,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="EyeLScale"/></Border.RenderTransform>
                                </Border>
                                <Border x:Name="EyeR" Width="9" Height="15" CornerRadius="4.5" Background="White" Margin="5,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="EyeRScale"/></Border.RenderTransform>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="Zzz" Text="z" FontSize="11" Foreground="{StaticResource Sub}" HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,2,18,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="Wave" Text="👋" FontFamily="Segoe UI Emoji" FontSize="13" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed" RenderTransformOrigin="0.7,0.9">
                                <TextBlock.RenderTransform><RotateTransform x:Name="WaveRotate"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- ===== OGOHLANTIRISH ===== -->
                    <Grid x:Name="AlertView" Visibility="Collapsed" Margin="12,0" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AlertIconBg" Width="30" Height="30" CornerRadius="15" Background="#2230D158" VerticalAlignment="Center">
                            <TextBlock x:Name="AlertIcon" Style="{StaticResource Icon}" FontSize="14"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                            <TextBlock x:Name="AlertTitle" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AlertSub" Style="{StaticResource SubText}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Grid x:Name="AlertProgress" Grid.Column="2" Width="80" Height="5" VerticalAlignment="Center">
                            <Border Background="#33FFFFFF" CornerRadius="2.5"/>
                            <Border x:Name="AlertProgressFill" HorizontalAlignment="Left" Width="40" CornerRadius="2.5" Background="White"/>
                        </Grid>
                    </Grid>

                    <!-- ===== OCHILGAN HOLAT ===== -->
                    <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0" Width="660" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,8,12,0">
                            <StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="BigDate" Style="{StaticResource SubText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="BigClock" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="13" Content="&#xE713;"
                                        ToolTip="Sozlamalar" Click="Settings_Click"/>
                            </StackPanel>
                        </Grid>
                        <ContentControl x:Name="PageHost" Grid.Row="1" Margin="16,4,16,14" Focusable="False"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- O'ng "quloq" -->
            <Path x:Name="RightEar" Fill="Black" Width="12" Height="12" VerticalAlignment="Top"
                  Data="M0,0 L12,0 A12,12 0 0 0 0,12 Z"/>
        </StackPanel>
    </Grid>
</Window>
